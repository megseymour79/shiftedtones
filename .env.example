# Copy to .env.local for local development. Use the hosting/Convex secret
# managers for production; never put private values in VITE_* variables.

# Public client configuration (VITE_* values are included in browser assets).
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_PLAUSIBLE_DOMAIN=shiftedtone.com
VITE_PLAUSIBLE_API_HOST=https://plausible.io

# Convex deployment/auth configuration. CONVEX_DEPLOYMENT is for the Convex
# CLI; set the other server variables in the Convex deployment environment.
CONVEX_DEPLOYMENT=your-org:your-deployment
SITE_URL=http://localhost:5173
CONVEX_SITE_URL=http://localhost:3210
# Set JWT_PRIVATE_KEY and JWKS only as required by the deployed Convex Auth
# configuration. Generate them using the documented Convex Auth procedure.
# JWT_PRIVATE_KEY=
# JWKS=

# Server-only integration credentials. Never prefix these with VITE_.
# VLY_EMAIL_API_KEY=
# VLY_INTEGRATION_KEY=
# Optional overrides:
# VLY_APP_NAME=ShiftedTone
# VLY_CONVEX_AUTH_ISSUER=https://auth.freebuff.app
